# Copy this file to .env and fill in real values. Never commit .env.
SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,localhost
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,http://localhost:5173
FRONTEND_APP_URL=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@nereus.local
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DATABASE_URL=postgres://nereus_admin:yourpassword@db:5432/nereus
